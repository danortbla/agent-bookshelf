{
  "name": "agent-bookshelf",
  "version": "1.0.0",
  "description": "Goodreads-lite teaching playground for AI agents course",
  "type": "module",
  "main": "dist/server.js",
  "bin": {
    "agent-bookshelf": "./bin/agent-bookshelf.js"
  },
  "files": [
    "dist",
    "bin",
    "src/db/schema.sql",
    "src/db/seed.sql",
    "src/views",
    "src/public"
  ],
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "node node_modules/typescript/bin/tsc && npm run copy-assets",
    "copy-assets": "node -e \"const {cpSync} = require('fs'); cpSync('src/db/schema.sql', 'dist/db/schema.sql'); cpSync('src/db/seed.sql', 'dist/db/seed.sql'); cpSync('src/views', 'dist/views', {recursive: true}); cpSync('src/public', 'dist/public', {recursive: true});\"",
    "start": "node dist/server.js",
    "postinstall": "npm run build",
    "prepublishOnly": "npm run build",
    "test": "vitest",
    "test:run": "vitest run",
    "verify": "node scripts/verify.mjs"
  },
  "keywords": [
    "goodreads",
    "books",
    "ai-agents",
    "teaching",
    "playground"
  ],
  "author": "",
  "license": "GPL-3.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "ejs": "^3.1.10",
    "express": "^4.21.2",
    "htmx.org": "^1.9.12",
    "sql.js": "^1.12.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.2",
    "@types/supertest": "^6.0.2",
    "supertest": "^7.0.0",
    "tsx": "~4.20.6",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
